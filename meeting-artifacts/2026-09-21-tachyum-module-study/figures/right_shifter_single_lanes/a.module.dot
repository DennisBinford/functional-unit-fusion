digraph right_shifter_single_lanes_a_module {
  graph [rankdir=TB, fontname="Helvetica", labelloc="t", label="right_shifter_single_lanes_a - module level (2 nodes, 1 edges)", fontsize=16, nodesep=0.25, ranksep=0.6, bgcolor="white"];
  node  [fontname="Helvetica", fontsize=10, style="filled", penwidth=1.2, margin="0.08,0.04"];
  edge  [fontname="Helvetica", fontsize=8, color="#666666", arrowsize=0.6];
  right_shifter_74_with_outside_bits [label="right_shifter_74_with_outside_bits", shape=box3d, fillcolor="#e8eaf6", color="#3949ab"];
  tachyum_single_1_right_shifter [label="tachyum_single_1_right_shifter", shape=box3d, fillcolor="#e8eaf6", color="#3949ab"];
  tachyum_single_1_right_shifter -> right_shifter_74_with_outside_bits;
  subgraph cluster_legend {
    label="key"; fontname="Helvetica"; fontsize=10; color="#cccccc";
    legend [shape=plaintext, fillcolor="white", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
        <TR><TD BGCOLOR="#e8eaf6" WIDTH="16"></TD><TD ALIGN="LEFT">module</TD></TR>
      </TABLE>>];
  }
}