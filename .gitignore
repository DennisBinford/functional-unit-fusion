*.py[cod]
.pytest_cache/
build/
tools/

# Local meeting media and transcripts: keep originals out of version control.
meetings/2026-summer-professor/recordings/*
!meetings/2026-summer-professor/recordings/.gitkeep
third_party/
designs/*.source.json

.venv/
.DS_Store

# working docs -- keep local, do not publish
*.md

# local commit helper -- keep local, do not publish (it runs `git add -A`, so it
# must be ignored or it would re-add itself on the next run)
/commit.sh

# scratch notes + throwaway experiments (kept local, not published)
brainstorm/
# generated by experiments/shareability.py (regenerable; PDK lib is vendored)
experiments/gen/
experiments/nangate45_typical.lib
experiments/shareability.json
